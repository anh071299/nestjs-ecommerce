// use prisma-next

enum Role {
  @@type("pg/text@1")
  USER  = "USER"
  ADMIN = "ADMIN"
}

model User {
  id        Uuid                 @id @default(uuid())
  email     String               @unique
  password  String
  name      String 
  role      Role                 @default(USER)
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@map("user")
}
